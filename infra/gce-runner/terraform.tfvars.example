project_id  = "my-gcp-security-project"
region      = "us-central1"
zone        = "us-central1-a"
github_repo = "shansri-google/CodeMender"

# Warm ephemeral runners kept ready by the MIG. 1 is enough for a demo.
runner_count = 1
machine_type = "e2-standard-4"

